diff --git a/yaml_cpp_vendor-extras.cmake.in b/yaml_cpp_vendor-extras.cmake.in
index 2c09e7c..0ab2e9a 100644
--- a/yaml_cpp_vendor-extras.cmake.in
+++ b/yaml_cpp_vendor-extras.cmake.in
@@ -1,7 +1,29 @@
 # add the local Modules directory to the modules path
-if(WIN32)
-  set(yaml-cpp_DIR "${@PROJECT_NAME@_DIR}/../../../opt/yaml_cpp_vendor/CMake")
-else()
-  set(yaml-cpp_DIR "${@PROJECT_NAME@_DIR}/../../../opt/yaml_cpp_vendor/share/cmake/yaml-cpp")
+#
+# yaml-cpp has moved its installed package config twice: <=0.6.x used CMake/ on Windows and
+# share/cmake/yaml-cpp elsewhere, while 0.8.0 -- the version ament_vendor() pins in CMakeLists.txt
+# -- switched to GNUInstallDirs and installs to lib/cmake/yaml-cpp on every platform. Guessing the
+# location from the platform therefore gets it wrong for the version we actually build, and the
+# failure is silent: yaml-cpp_DIR points at nothing, find_package falls through, and the first
+# symptom is camera_calibration_parsers failing to link. Probe for the config instead.
+set(_yaml_cpp_vendor_prefix "${@PROJECT_NAME@_DIR}/../../../opt/yaml_cpp_vendor")
+foreach(_yaml_cpp_candidate
+    "${_yaml_cpp_vendor_prefix}/lib/cmake/yaml-cpp"
+    "${_yaml_cpp_vendor_prefix}/share/cmake/yaml-cpp"
+    "${_yaml_cpp_vendor_prefix}/CMake")
+  if(EXISTS "${_yaml_cpp_candidate}")
+    set(yaml-cpp_DIR "${_yaml_cpp_candidate}")
+    break()
+  endif()
+endforeach()
+if(NOT yaml-cpp_DIR)
+  # Nothing found: keep the upstream guess so the error message stays recognisable.
+  if(WIN32)
+    set(yaml-cpp_DIR "${_yaml_cpp_vendor_prefix}/CMake")
+  else()
+    set(yaml-cpp_DIR "${_yaml_cpp_vendor_prefix}/share/cmake/yaml-cpp")
+  endif()
 endif()
+unset(_yaml_cpp_vendor_prefix)
+unset(_yaml_cpp_candidate)
 message(STATUS "Setting yaml-cpp_DIR to: '${yaml-cpp_DIR}'")
