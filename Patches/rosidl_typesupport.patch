+// Look a typesupport symbol up among the symbols the process has already loaded.
+//
+// Upstream expects each package's typesupport to live in a separate shared library that it can
+// dlopen on demand. Under Unreal that assumption does not hold: the ROS libraries are linked or
+// preloaded into a single process image, so the per-package library either does not exist as a
+// standalone file or cannot be opened by name. The symbol is still there -- it is already in the
+// process -- so rather than failing we search what is loaded.
+inline void * get_typesupport_symbol_from_process(const char * symbol_name)
+{
+#ifndef _WIN32
+  // Clear any stale error first. dlerror() is the only way to tell a symbol that legitimately
+  // resolved to nullptr apart from one that was not found at all.
+  dlerror();
+  void * sym = dlsym(RTLD_DEFAULT, symbol_name);
+  const char * error = dlerror();
+  if (error != nullptr) {
+    RCUTILS_SET_ERROR_MSG_WITH_FORMAT_STRING(
+      "Failed to get symbol '%s' in global scope: %s", symbol_name, error);
+    return nullptr;
+  }
+  return sym;
+#else
+  // Windows has no RTLD_DEFAULT equivalent -- there is no way to search the whole process at once
+  // -- so enumerate the loaded modules and ask each one in turn.
+  HANDLE process = GetCurrentProcess();
+  DWORD bytes_needed = 0;
+
+  // First call just sizes the buffer.
+  if (!EnumProcessModules(process, nullptr, 0, &bytes_needed) || bytes_needed == 0) {
+    RCUTILS_SET_ERROR_MSG_WITH_FORMAT_STRING(
+      "Failed to enumerate process modules while looking for symbol '%s': %lu",
+      symbol_name, GetLastError());
+    return nullptr;
+  }
+
+  size_t num_modules = bytes_needed / sizeof(HMODULE);
+  auto modules = std::make_unique<HMODULE[]>(num_modules);
+  if (!EnumProcessModules(process, modules.get(), bytes_needed, &bytes_needed)) {
+    RCUTILS_SET_ERROR_MSG_WITH_FORMAT_STRING(
+      "Failed to enumerate process modules while looking for symbol '%s': %lu",
+      symbol_name, GetLastError());
+    return nullptr;
+  }
+  // A module can be unloaded between the two calls, so trust the second count, and never read
+  // past the buffer we actually allocated.
+  size_t num_modules_filled = bytes_needed / sizeof(HMODULE);
+  if (num_modules_filled < num_modules) {
+    num_modules = num_modules_filled;
+  }
+
+  for (size_t i = 0; i < num_modules; ++i) {
+    // GetProcAddress returns FARPROC (a function pointer); the caller immediately casts it back
+    // to a function pointer, so round-tripping through void * here is safe in practice and is
+    // what the rest of this file already does with dlsym.
+    void * sym = reinterpret_cast<void *>(GetProcAddress(modules[i], symbol_name));
+    if (sym != nullptr) {
+      return sym;
+    }
+  }
+
+  RCUTILS_SET_ERROR_MSG_WITH_FORMAT_STRING(
+    "Failed to find symbol '%s' in any of the %zu modules loaded in this process",
+    symbol_name, num_modules);
+  return nullptr;
+#endif  // _WIN32
+}
