diff --git a/orocos_kdl_vendor/CMakeLists.txt b/orocos_kdl_vendor/CMakeLists.txt
index ae3739a..5ab017d 100644
--- a/orocos_kdl_vendor/CMakeLists.txt
+++ b/orocos_kdl_vendor/CMakeLists.txt
@@ -13,6 +13,20 @@ if(NOT CMAKE_CXX_STANDARD)
   set(CMAKE_CXX_STANDARD_REQUIRED ON)
 endif()
 
+# ament_vendor() generates an initial-cache file for the nested build, but it only forwards a fixed
+# list of variables (compilers, flags, CMAKE_MODULE_PATH, CMAKE_PREFIX_PATH, BUILD_*). EIGEN3_INCLUDE_DIR
+# is not on that list, so orocos_kdl would fall back to looking for a system Eigen and not find the
+# copy we hand it out of Unreal's ThirdParty tree. Forward it explicitly.
+#
+# TO_CMAKE_PATH is not optional here: ament_vendor() re-parses these arguments with
+# cmake_parse_arguments, and a native Windows path (C:\rclbld\eigen-cp) fails that parse with
+# "Invalid character escape '\e'".
+set(_orocos_kdl_extra_cmake_args)
+if(DEFINED EIGEN3_INCLUDE_DIR)
+  file(TO_CMAKE_PATH "${EIGEN3_INCLUDE_DIR}" _orocos_kdl_eigen_dir)
+  list(APPEND _orocos_kdl_extra_cmake_args "-DEIGEN3_INCLUDE_DIR=${_orocos_kdl_eigen_dir}")
+endif()
+
 ament_vendor(orocos_kdl_vendor
   SATISFIED ${orocos_kdl_FOUND}
   VCS_URL https://github.com/orocos/orocos_kinematics_dynamics.git
@@ -22,6 +36,7 @@ ament_vendor(orocos_kdl_vendor
   CMAKE_ARGS
     -DENABLE_TESTS:BOOL=OFF
     -DENABLE_EXAMPLES:BOOL=OFF
+    ${_orocos_kdl_extra_cmake_args}
   PATCHES patches
 )
 
